NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GCP Console > APIs & Services > Credentials. Needs the "Cloud Text-to-Speech API" enabled on
# the project (this is a separate API from the Gemini API - GEMINI_API_KEY will not work here).
GOOGLE_CLOUD_TTS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs from the Stripe Dashboard (Product catalog). Must match the mode (test/live) of STRIPE_SECRET_KEY.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_RESUME_UNLOCK=
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile CAPTCHA (defaults to Cloudflare always-pass test keys for local dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: Redis-backed rate limiting (Upstash REST; Vercel Marketplace "Upstash Redis" sets these).
# Unset = limiter uses the atomic Postgres function. Set = Redis first, Postgres as fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI cost controls. Set these in production - see docs/rate-limiting-report.md follow-ups.
# false/unset = credit quotas are only RECORDED (shadow mode), never enforced. Flip to true once the
# limit-reached UI exists and the credit numbers are signed off (checklist in lib/aiGateway/gateway.ts).
AI_GATEWAY_LIVE_ENFORCEMENT=
# Circuit breaker on the AI request path. Enforce only after setting real baselines (defaults are guesses).
AI_BREAKER_ENFORCE=
AI_BREAKER_BASELINE_CALLS=50
AI_BREAKER_BASELINE_COST_USD=0.5
AI_BREAKER_ALERT_MULTIPLIER=1.5
AI_BREAKER_CRITICAL_MULTIPLIER=3
# Slack/Discord-style incoming webhook, called (once per 15 min) when the breaker goes critical.
AI_BREAKER_ALERT_WEBHOOK_URL=
